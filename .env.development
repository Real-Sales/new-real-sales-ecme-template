# Used only for `vite` / `npm run dev` (not `vite build`).
# Empty base → axios uses same origin (e.g. http://localhost:5173) + path below;
# Vite proxies /api → FastAPI (see vite.config.ts, default http://127.0.0.1:8000).
VITE_BASE_URL=
VITE_API_PREFIX=/api/v1/

# Optional: if uvicorn listens elsewhere
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:9000
